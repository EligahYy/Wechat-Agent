diff --git a/crates/wx-db/src/identity.rs b/crates/wx-db/src/identity.rs
new file mode 100644
index 0000000..4fb0530
--- /dev/null
+++ b/crates/wx-db/src/identity.rs
@@ -0,0 +1,244 @@
+//! Structured source identities. Empty fields and unreadable fields stay distinct.
+
+use crate::{ChatRoomMember, DbError, QueryResult, QueryStats, WechatDb};
+use prost::Message;
+use rusqlite::{types::ValueRef, Connection};
+use serde::Serialize;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum NameState {
+    Known,
+    Empty,
+    Unreadable,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct IdentityName {
+    pub value: Option<String>,
+    pub state: NameState,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct IdentityContact {
+    pub user_name: String,
+    pub remark: IdentityName,
+    pub nickname: IdentityName,
+    pub relationship: &'static str,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct IdentityGroup {
+    pub username: String,
+    pub members_state: NameState,
+    pub members: Vec<ChatRoomMember>,
+}
+
+fn read_name(value: ValueRef<'_>) -> IdentityName {
+    match value {
+        ValueRef::Null => IdentityName {
+            value: None,
+            state: NameState::Empty,
+        },
+        ValueRef::Text(bytes) => match std::str::from_utf8(bytes) {
+            Ok(text) if text.trim().is_empty() => IdentityName {
+                value: None,
+                state: NameState::Empty,
+            },
+            Ok(text) => IdentityName {
+                value: Some(text.to_string()),
+                state: NameState::Known,
+            },
+            Err(_) => IdentityName {
+                value: None,
+                state: NameState::Unreadable,
+            },
+        },
+        _ => IdentityName {
+            value: None,
+            state: NameState::Unreadable,
+        },
+    }
+}
+
+fn read_contacts(
+    conn: &Connection,
+    limit: usize,
+    offset: usize,
+) -> Result<QueryResult<IdentityContact>, DbError> {
+    let total_rows: i64 = conn.query_row("SELECT COUNT(*) FROM contact", [], |row| row.get(0))?;
+    let mut stmt = conn.prepare(
+        "SELECT username,remark,nick_name FROM contact ORDER BY username LIMIT ?1 OFFSET ?2",
+    )?;
+    let rows = stmt.query_map([limit as i64, offset as i64], |row| {
+        Ok(IdentityContact {
+            user_name: row.get(0)?,
+            remark: read_name(row.get_ref(1)?),
+            nickname: read_name(row.get_ref(2)?),
+            // No verified friend-status column exists in the pinned contract.
+            relationship: "unknown",
+        })
+    })?;
+    let mut items = Vec::new();
+    let mut skipped = 0;
+    for row in rows {
+        match row {
+            Ok(value) => items.push(value),
+            Err(_) => skipped += 1,
+        }
+    }
+    Ok(QueryResult {
+        items,
+        stats: QueryStats {
+            total_rows: total_rows as usize,
+            filtered_count: None,
+            skipped,
+        },
+    })
+}
+
+fn read_groups(
+    conn: &Connection,
+    limit: usize,
+    offset: usize,
+) -> Result<QueryResult<IdentityGroup>, DbError> {
+    let total_rows: i64 = conn.query_row("SELECT COUNT(*) FROM chat_room", [], |row| row.get(0))?;
+    let mut stmt = conn.prepare(
+        "SELECT username,ext_buffer FROM chat_room ORDER BY username LIMIT ?1 OFFSET ?2",
+    )?;
+    let rows = stmt.query_map([limit as i64, offset as i64], |row| {
+        let username: String = row.get(0)?;
+        let (members_state, members) = match row.get_ref(1)? {
+            ValueRef::Null => (NameState::Empty, Vec::new()),
+            ValueRef::Blob(bytes) if bytes.is_empty() => (NameState::Empty, Vec::new()),
+            ValueRef::Blob(bytes) => match crate::decode::RoomDataProto::decode(bytes) {
+                Ok(proto) => (
+                    NameState::Known,
+                    proto
+                        .users
+                        .into_iter()
+                        .map(|user| ChatRoomMember {
+                            user_name: user.user_name,
+                            display_name: user.display_name.filter(|name| !name.trim().is_empty()),
+                        })
+                        .collect(),
+                ),
+                Err(_) => (NameState::Unreadable, Vec::new()),
+            },
+            _ => (NameState::Unreadable, Vec::new()),
+        };
+        Ok(IdentityGroup {
+            username,
+            members_state,
+            members,
+        })
+    })?;
+    let mut items = Vec::new();
+    let mut skipped = 0;
+    for row in rows {
+        match row {
+            Ok(value) => items.push(value),
+            Err(_) => skipped += 1,
+        }
+    }
+    Ok(QueryResult {
+        items,
+        stats: QueryStats {
+            total_rows: total_rows as usize,
+            filtered_count: None,
+            skipped,
+        },
+    })
+}
+
+impl WechatDb {
+    pub fn query_identity_contacts(
+        &self,
+        limit: usize,
+        offset: usize,
+    ) -> Result<QueryResult<IdentityContact>, DbError> {
+        read_contacts(&self.contact_conn, crate::effective_limit(limit), offset)
+    }
+    pub fn query_identity_groups(
+        &self,
+        limit: usize,
+        offset: usize,
+    ) -> Result<QueryResult<IdentityGroup>, DbError> {
+        read_groups(&self.contact_conn, crate::effective_limit(limit), offset)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rusqlite::{params, Connection};
+
+    #[test]
+    fn identity_names_distinguish_null_empty_bad_types_and_utf8() {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch("CREATE TABLE contact(username TEXT, remark, nick_name);")
+            .unwrap();
+        conn.execute("INSERT INTO contact VALUES('a',NULL,'')", [])
+            .unwrap();
+        conn.execute(
+            "INSERT INTO contact VALUES('b',?1,?2)",
+            params![vec![0xff_u8], "小林🧑‍💻"],
+        )
+        .unwrap();
+        conn.execute("INSERT INTO contact VALUES('c',CAST(x'ff' AS TEXT),42)", [])
+            .unwrap();
+        let page = read_contacts(&conn, 20, 0).unwrap();
+        assert_eq!(page.items[0].remark.state, NameState::Empty);
+        assert_eq!(page.items[0].nickname.value, None);
+        assert_eq!(page.items[1].remark.state, NameState::Unreadable);
+        assert_eq!(page.items[1].nickname.value.as_deref(), Some("小林🧑‍💻"));
+        assert_eq!(page.items[2].remark.state, NameState::Unreadable);
+        assert_eq!(page.items[2].nickname.state, NameState::Unreadable);
+    }
+
+    #[test]
+    fn unreadable_person_identifier_counts_as_skipped() {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch("CREATE TABLE contact(username,remark,nick_name); INSERT INTO contact VALUES(NULL,'x','y'),('valid','','hello');").unwrap();
+        let page = read_contacts(&conn, 20, 0).unwrap();
+        assert_eq!(page.stats.skipped, 1);
+        assert_eq!(page.items.len(), 1);
+        assert_eq!(page.stats.total_rows, 2);
+    }
+
+    #[test]
+    fn group_decode_error_does_not_become_a_valid_empty_roster() {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch("CREATE TABLE chat_room(username TEXT,ext_buffer BLOB);")
+            .unwrap();
+        conn.execute(
+            "INSERT INTO chat_room VALUES('room@chatroom',?1)",
+            params![vec![0xff_u8]],
+        )
+        .unwrap();
+        let page = read_groups(&conn, 20, 0).unwrap();
+        assert_eq!(page.items[0].members_state, NameState::Unreadable);
+        assert!(page.items[0].members.is_empty());
+    }
+
+    #[test]
+    fn group_names_keep_room_scope_and_member_ids() {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch("CREATE TABLE chat_room(username TEXT,ext_buffer BLOB);")
+            .unwrap();
+        let members = vec![("old.alias", Some("群内名称"))];
+        let blob = crate::encode_room_data_for_test(&members);
+        conn.execute(
+            "INSERT INTO chat_room VALUES('room@chatroom',?1)",
+            params![blob],
+        )
+        .unwrap();
+        let page = read_groups(&conn, 20, 0).unwrap();
+        assert_eq!(page.items[0].members_state, NameState::Known);
+        assert_eq!(page.items[0].members[0].user_name, "old.alias");
+        assert_eq!(
+            page.items[0].members[0].display_name.as_deref(),
+            Some("群内名称")
+        );
+    }
+}
