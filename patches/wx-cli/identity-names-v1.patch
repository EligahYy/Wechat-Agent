diff --git a/crates/wx-cli/src/cmd/serve/identity.rs b/crates/wx-cli/src/cmd/serve/identity.rs
new file mode 100644
index 0000000..9bdabb7
--- /dev/null
+++ b/crates/wx-cli/src/cmd/serve/identity.rs
@@ -0,0 +1,387 @@
+//! Versioned read-only identity metadata and explicit cache refresh.
+
+use super::{error::ServeError, state::AppState};
+use crate::output::JsonEnvelope;
+use axum::{
+    extract::{Query, State},
+    http::StatusCode,
+    response::IntoResponse,
+    Json,
+};
+use serde::{Deserialize, Serialize};
+use std::sync::{Arc, RwLock};
+use wx_context::ContactResolver;
+
+#[derive(Clone, Serialize)]
+pub struct IdentitySnapshot {
+    pub contract: &'static str,
+    pub patch_id: &'static str,
+    pub mode: &'static str,
+    pub generation: u64,
+    pub resolver_generation: u64,
+    pub refreshed_at: String,
+    pub refresh_state: &'static str,
+    #[serde(skip)]
+    resolver: Arc<ContactResolver>,
+}
+
+pub struct IdentityRuntime(RwLock<IdentitySnapshot>);
+
+impl IdentityRuntime {
+    pub fn new(resolver: ContactResolver, mode: &'static str) -> Self {
+        Self(RwLock::new(IdentitySnapshot {
+            contract: "wechat-agent-source-v1",
+            patch_id: "wechat-agent.1",
+            mode,
+            generation: 0,
+            resolver_generation: 0,
+            refreshed_at: chrono::Utc::now().to_rfc3339(),
+            refresh_state: "ready",
+            resolver: Arc::new(resolver),
+        }))
+    }
+    pub fn snapshot(&self) -> IdentitySnapshot {
+        self.0.read().unwrap().clone()
+    }
+    pub fn resolver(&self) -> Arc<ContactResolver> {
+        self.snapshot().resolver
+    }
+    pub fn refreshing(&self) {
+        self.0.write().unwrap().refresh_state = "running";
+    }
+    pub fn failed(&self) {
+        self.0.write().unwrap().refresh_state = "failed";
+    }
+    pub fn publish(&self, resolver: ContactResolver) {
+        let mut value = self.0.write().unwrap();
+        value.generation += 1;
+        value.resolver_generation = value.generation;
+        value.refreshed_at = chrono::Utc::now().to_rfc3339();
+        value.refresh_state = "ready";
+        value.resolver = Arc::new(resolver);
+    }
+}
+
+#[derive(Deserialize)]
+pub struct IdentityParams {
+    #[serde(default = "default_limit")]
+    limit: usize,
+    #[serde(default)]
+    offset: usize,
+    generation: Option<u64>,
+    show_hidden: Option<String>,
+}
+fn default_limit() -> usize {
+    200
+}
+
+async fn metadata(
+    state: Arc<AppState>,
+    params: IdentityParams,
+    groups: bool,
+) -> Result<Json<serde_json::Value>, ServeError> {
+    if params.show_hidden.as_deref() != Some("1") {
+        return Err(ServeError::InvalidParam(
+            "full_metadata_scope_required".into(),
+        ));
+    }
+    if params.limit == 0 || params.limit > 500 || params.offset > 200_000 {
+        return Err(ServeError::InvalidParam(
+            "metadata_page_limit_invalid".into(),
+        ));
+    }
+    let result = tokio::task::spawn_blocking(move || {
+        let db = state
+            .db
+            .lock()
+            .map_err(|_| ServeError::Internal("metadata_lock_failed".into()))?;
+        let info = state.identity.snapshot();
+        if info.refresh_state != "ready" {
+            return Err(ServeError::Internal("metadata_refresh_not_ready".into()));
+        }
+        if params
+            .generation
+            .is_some_and(|expected| expected != info.generation)
+        {
+            return Err(ServeError::Conflict("metadata_generation_changed".into()));
+        }
+        let mut output = if groups {
+            let page = db
+                .query_identity_groups(params.limit, params.offset)
+                .map_err(|_| ServeError::Db("group_metadata_read_failed".into()))?;
+            serde_json::to_value(JsonEnvelope::from_query_result(
+                page,
+                params.limit,
+                params.offset,
+                |row| row,
+            ))
+        } else {
+            let page = db
+                .query_identity_contacts(params.limit, params.offset)
+                .map_err(|_| ServeError::Db("contact_metadata_read_failed".into()))?;
+            serde_json::to_value(JsonEnvelope::from_query_result(
+                page,
+                params.limit,
+                params.offset,
+                |row| row,
+            ))
+        }
+        .map_err(|_| ServeError::Internal("metadata_encode_failed".into()))?;
+        let total = output["paging"]["total"].as_u64().unwrap_or(0);
+        output["paging"]["has_more"] =
+            serde_json::json!((params.offset + params.limit) < total as usize);
+        output["metadata"] = serde_json::to_value(info)
+            .map_err(|_| ServeError::Internal("metadata_encode_failed".into()))?;
+        Ok(output)
+    })
+    .await
+    .map_err(|_| ServeError::Internal("metadata_task_failed".into()))??;
+    Ok(Json(result))
+}
+
+pub async fn contacts(
+    State(state): State<Arc<AppState>>,
+    Query(params): Query<IdentityParams>,
+) -> Result<impl IntoResponse, ServeError> {
+    metadata(state, params, false).await
+}
+pub async fn groups(
+    State(state): State<Arc<AppState>>,
+    Query(params): Query<IdentityParams>,
+) -> Result<impl IntoResponse, ServeError> {
+    metadata(state, params, true).await
+}
+pub async fn refresh(State(state): State<Arc<AppState>>) -> Result<impl IntoResponse, ServeError> {
+    let generation = state.identity.snapshot().generation;
+    state
+        .refresh_tx
+        .send(super::refresh::RefreshTrigger::Refresh)
+        .await
+        .map_err(|_| ServeError::Internal("metadata_refresh_unavailable".into()))?;
+    Ok((
+        StatusCode::ACCEPTED,
+        Json(serde_json::json!({"generation":generation, "refresh_state":"queued"})),
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use wx_context::ContactResolver;
+
+    #[test]
+    fn failed_refresh_preserves_generation_and_reports_failure() {
+        let runtime = IdentityRuntime::new(ContactResolver::empty(), "decrypted_cache");
+        runtime.refreshing();
+        assert_eq!(runtime.snapshot().refresh_state, "running");
+        runtime.failed();
+        let info = runtime.snapshot();
+        assert_eq!(info.generation, 0);
+        assert_eq!(info.resolver_generation, 0);
+        assert_eq!(info.refresh_state, "failed");
+    }
+
+    #[test]
+    fn published_resolver_and_generation_change_together() {
+        let runtime = IdentityRuntime::new(ContactResolver::empty(), "sqlcipher");
+        runtime.refreshing();
+        runtime.publish(ContactResolver::empty());
+        let info = runtime.snapshot();
+        assert_eq!(info.generation, 1);
+        assert_eq!(info.resolver_generation, 1);
+        assert_eq!(info.refresh_state, "ready");
+        let output = serde_json::to_value(info).unwrap();
+        assert!(output.get("resolver").is_none());
+        assert_eq!(output["contract"], "wechat-agent-source-v1");
+    }
+}
+#[cfg(test)]
+mod http_tests {
+    use super::*;
+    use axum::{
+        body::{to_bytes, Body},
+        http::Request,
+    };
+    use lru::LruCache;
+    use std::{
+        num::NonZeroUsize,
+        path::PathBuf,
+        sync::{atomic::AtomicBool, Mutex},
+    };
+    use tokio::sync::{broadcast, mpsc};
+    use tokio_util::sync::CancellationToken;
+    use tower::ServiceExt;
+    use wx_context::{ContactResolver, VisibilityIndex};
+
+    fn fixture() -> (
+        Arc<AppState>,
+        tempfile::TempDir,
+        mpsc::Receiver<super::super::refresh::RefreshTrigger>,
+    ) {
+        let dir = tempfile::tempdir().unwrap();
+        for child in ["contact", "session", "message"] {
+            std::fs::create_dir_all(dir.path().join(child)).unwrap();
+        }
+        let contact = rusqlite::Connection::open(dir.path().join("contact/contact.db")).unwrap();
+        wx_db::test_ddl::create_test_contact_table(&contact);
+        contact.execute_batch("CREATE TABLE chat_room(username TEXT,ext_buffer BLOB); INSERT INTO contact(username,remark,nick_name) VALUES('person','', '真实昵称');").unwrap();
+        let blob = wx_db::encode_room_data_for_test(&[("person", Some("群名片"))]);
+        contact
+            .execute("INSERT INTO chat_room VALUES('room@chatroom',?1)", [blob])
+            .unwrap();
+        let session = rusqlite::Connection::open(dir.path().join("session/session.db")).unwrap();
+        wx_db::test_ddl::create_test_session_table(&session);
+        let db = wx_db::WechatDb::open(dir.path()).unwrap();
+        let resolver = ContactResolver::build(&db).unwrap();
+        let (tx, _) = broadcast::channel(8);
+        let (refresh_tx, refresh_rx) = mpsc::channel(8);
+        let state = Arc::new(AppState {
+            db: Arc::new(Mutex::new(db)),
+            self_wxid: "self".into(),
+            current_account: super::super::state::CurrentAccount {
+                wxid: "self".into(),
+                name: "Self".into(),
+            },
+            worker_id: "synthetic-worker".into(),
+            cli_version: "0.7.4+wechat-agent.1".into(),
+            identity: Arc::new(IdentityRuntime::new(resolver, "decrypted_cache")),
+            visibility: Arc::new(VisibilityIndex::empty()),
+            broadcast_tx: tx,
+            auth_token: Some("test-token".into()),
+            ready: AtomicBool::new(true),
+            refresh_tx,
+            shutdown: CancellationToken::new(),
+            fts_conn: None,
+            attach_dir: PathBuf::new(),
+            media_db_dir: PathBuf::new(),
+            file_dir: PathBuf::new(),
+            video_dir: PathBuf::new(),
+            hardlink_db_path: PathBuf::new(),
+            hardlink_db_conn: Arc::new(Mutex::new(None)),
+            raw_key: None,
+            dat_decrypt: wx_media::DatDecryptOptions::default(),
+            voice_cache: Arc::new(Mutex::new(LruCache::new(NonZeroUsize::new(8).unwrap()))),
+            image_xor_cache: Arc::new(Mutex::new(LruCache::new(NonZeroUsize::new(8).unwrap()))),
+            name2id_cache: Arc::new(Mutex::new(None)),
+            media_db_paths: Arc::new(Mutex::new(None)),
+        });
+        (state, dir, refresh_rx)
+    }
+
+    async fn get(state: Arc<AppState>, path: &str) -> (u16, serde_json::Value) {
+        let request = Request::builder()
+            .uri(path)
+            .header("authorization", "Bearer test-token")
+            .body(Body::empty())
+            .unwrap();
+        let response = super::super::routes::build_router(state)
+            .oneshot(request)
+            .await
+            .unwrap();
+        let status = response.status().as_u16();
+        let bytes = to_bytes(response.into_body(), 1024 * 1024).await.unwrap();
+        (status, serde_json::from_slice(&bytes).unwrap())
+    }
+
+    #[tokio::test]
+    async fn identity_routes_publish_structured_names_and_require_auth() {
+        let (state, _dir, _rx) = fixture();
+        let (code, contacts) = get(
+            state.clone(),
+            "/api/v1/identity/contacts?limit=200&offset=0&show_hidden=1",
+        )
+        .await;
+        assert_eq!(code, 200);
+        assert_eq!(contacts["items"][0]["nickname"]["value"], "真实昵称");
+        assert_eq!(contacts["items"][0]["remark"]["state"], "empty");
+        let (_, groups) = get(
+            state.clone(),
+            "/api/v1/identity/groups?limit=200&offset=0&show_hidden=1",
+        )
+        .await;
+        assert_eq!(groups["items"][0]["members"][0]["display_name"], "群名片");
+        let (code, _) = get(
+            state.clone(),
+            "/api/v1/identity/contacts?generation=99&show_hidden=1",
+        )
+        .await;
+        assert_eq!(code, 409);
+        let response = super::super::routes::build_router(state)
+            .oneshot(
+                Request::builder()
+                    .uri("/api/v1/identity/groups")
+                    .body(Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(response.status().as_u16(), 401);
+    }
+
+    #[test]
+    fn corroborated_person_prefix_conflict_is_explicitly_unattributed() {
+        let (state, _dir, _rx) = fixture();
+        let message = wx_db::Message {
+            sort_seq: 1,
+            server_id: 1,
+            msg_type: 1,
+            sub_type: 0,
+            sender: "other-name2id-person".into(),
+            talker: "room@chatroom".into(),
+            create_time: 1,
+            content: wx_db::MessageContent::Text("person:\nhello".into()),
+            status: 0,
+        };
+        let enriched = crate::schema::enrich_message(message, "self", &state.identity.resolver());
+        assert!(enriched.message.sender.is_empty());
+        let wire = serde_json::to_value(enriched).unwrap();
+        assert_eq!(wire["sender_issue"], "sender_prefix_conflict");
+        assert_eq!(wire["content"]["Text"], "person:\nhello");
+    }
+
+    #[test]
+    fn conflicted_identity_does_not_bypass_existing_sender_visibility() {
+        let (state, _dir, _rx) = fixture();
+        let resolver = state.identity.resolver();
+        let message = wx_db::Message {
+            sort_seq: 1,
+            server_id: 1,
+            msg_type: 1,
+            sub_type: 0,
+            sender: "other-name2id-person".into(),
+            talker: "room@chatroom".into(),
+            create_time: 1,
+            content: wx_db::MessageContent::Text("person:\nhello".into()),
+            status: 0,
+        };
+        let visibility = VisibilityIndex::build(&["person".into()], &[], &resolver);
+        let enriched = crate::schema::enrich_message(message, "self", &resolver);
+        assert!(
+            crate::schema::project_message_item(enriched, "room@chatroom", &visibility).is_none()
+        );
+    }
+
+    #[tokio::test]
+    async fn fresh_resolver_and_health_have_the_same_generation() {
+        let (state, dir, _rx) = fixture();
+        let before = state.identity.resolver();
+        assert_eq!(before.display_name("person"), "真实昵称");
+        let conn = rusqlite::Connection::open(dir.path().join("contact/contact.db")).unwrap();
+        conn.execute("UPDATE contact SET nick_name='新昵称'", [])
+            .unwrap();
+        {
+            let db = state.db.lock().unwrap();
+            state.identity.publish(ContactResolver::build(&db).unwrap());
+        }
+        assert_eq!(before.display_name("person"), "真实昵称");
+        assert_eq!(state.identity.resolver().display_name("person"), "新昵称");
+        let (_, health) = get(state.clone(), "/api/v1/health").await;
+        assert_eq!(health["metadata"]["generation"], 1);
+        assert_eq!(health["metadata"]["resolver_generation"], 1);
+        assert_eq!(health["metadata"]["patch_id"], "wechat-agent.1");
+        state.identity.failed();
+        let (_, health) = get(state, "/api/v1/health").await;
+        assert_eq!(health["metadata"]["refresh_state"], "failed");
+        assert_eq!(health["ready"], false);
+    }
+}
